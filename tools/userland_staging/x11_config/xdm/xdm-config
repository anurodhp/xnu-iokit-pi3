! xdm-config for this port. Based on third_party/xdm/config/xdm-config.in
! (xdm-1.1.17); paths are the --prefix=/usr/X11 expansion of its XDMDIR,
! XDMCONFIGDIR, XDMSCRIPTDIR, XDMLOGDIR, XDMXAUTHDIR and XDMPIDDIR.
DisplayManager.authDir:		/var/lib/xdm
DisplayManager.errorLogFile:	/var/log/xdm.log
DisplayManager.pidFile:		/var/run/xdm.pid
DisplayManager.keyFile:		/usr/X11/lib/X11/xdm/xdm-keys
DisplayManager.servers:		/usr/X11/lib/X11/xdm/Xservers
DisplayManager.accessFile:	/usr/X11/lib/X11/xdm/Xaccess
DisplayManager*greeterLib:	/usr/X11/lib/X11/xdm/libXdmGreet.so
! Resources for the greeter are NOT loaded through xrdb (the image has no
! xrdb or cpp, so DisplayManager*resources is left unset and xdm's
! LoadXloginResources, session.c:421-426, does nothing). They live in the
! Xt app-defaults file /usr/X11/share/X11/app-defaults/Xlogin instead:
! greet.c:255 opens the display as application "xlogin", class "Xlogin",
! and libXt's XFILESEARCHPATHDEFAULT (build_libXt.sh) contains
! $datadir/X11/%T/%N%S.
DisplayManager*authorize:	true
DisplayManager*chooser:		/usr/X11/lib/X11/xdm/chooser
DisplayManager*startup:		/usr/X11/lib/X11/xdm/Xstartup
DisplayManager*session:		/usr/X11/lib/X11/xdm/Xsession
DisplayManager*reset:		/usr/X11/lib/X11/xdm/Xreset
DisplayManager*authComplain:	true
DisplayManager._0.setup:	/usr/X11/lib/X11/xdm/Xsetup
! Restart Xorg after every session instead of resetting it in place: a
! fresh Xorg start is the path verified on hardware (old x11-session
! restarted it too); an in-place server reset is not.
DisplayManager*terminateServer:	true
DisplayManager*loginmoveInterval:	10
! SECURITY: do not listen for XDMCP or Chooser requests (same as upstream).
DisplayManager.requestPort:	0
! MIT-MAGIC-COOKIE-1 only. xdm is built HASXDMAUTH (xdm/resource.c:109-113
! then defaults authName to "XDM-AUTHORIZATION-1 MIT-MAGIC-COOKIE-1", and
! libxcb, built HASXDMAUTH too, prefers the XDM entry when it reads the
! Xauthority xdm writes), but this port's X server is built
! -Dxdm-auth-1=false (build_xserver.sh:188; xserver os/auth.c:72-73
! registers XDM-AUTHORIZATION-1 only under HASXDMAUTH), so any client
! using that entry -- e.g. wmaker after login -- is refused with
! "Authorization protocol not supported by server". Seen on QEMU with
! Xvfb (same server-side build), where xwd failed until this was set.
DisplayManager*authName:	MIT-MAGIC-COOKIE-1
