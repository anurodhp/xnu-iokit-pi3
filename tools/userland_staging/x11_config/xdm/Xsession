#!/bin/sh
# The user's X session. xdm runs this as the logged-in user: session.c's
# StartClient does setgid + setlogin + initgroups + setuid to the account
# that greeter/verify.c authenticated, then execs this script with DISPLAY,
# HOME, USER, SHELL, PATH and XAUTHORITY in the environment. It must never
# be started as root by anything but a root login.
#
# It sets the GNUstep environment exactly as the old boot-time x11-session
# script did, then execs the window manager: Window Maker by default (its
# global autostart, /usr/X11/share/WindowMaker/autostart, opens Terminal.app),
# or Gershwin's WindowManager when /etc/x11-session.wm says "gershwin"
# (docs/gershwin-feasibility.md M3). A user's own ~/.xsession still wins.

# xdm's default user PATH (DEF_USER_PATH) has /bin and /usr/bin; the full
# session PATH is set below once the log is open.
PATH=/usr/X11/bin:/bin:/usr/bin:/sbin:/usr/sbin
export PATH

# XAUTHORITY: pin the cookie file before HOME changes below. xdm writes the
# session's cookie to "$HOME/.Xauthority" for the HOME it set
# (third_party/xdm/xdm/auth.c:1093, SetUserAuthorization) and exports
# XAUTHORITY only when it had to fall back to a temp file in userAuthDir
# (auth.c:1101 leaves setenv = 0 on the normal path; only the fallback at
# auth.c:1137 and a failed link at auth.c:1232 set it, and auth.c:1241-1245
# export it). Clients without XAUTHORITY read "$HOME/.Xauthority" of the
# HOME they see (third_party/libXau/AuFileName.c:56-58), so once HOME
# moves from "/" to /var/root they find no cookie: "Authorization required, but no authorization protocol
# specified" and wmaker exits at once. The first login on a fresh card got
# away with it only because no /.Xauthority existed yet: openFiles leaves
# old == NULL and auth.c:1098-1099 then take the temp-file fallback, which
# does export XAUTHORITY. Every later login finds the (emptied, by
# RemoveUserAuthorization at session end) /.Xauthority and takes the
# normal path.
if [ -z "$XAUTHORITY" ] && [ -n "$HOME" ]; then
    XAUTHORITY="${HOME%/}/.Xauthority"
    export XAUTHORITY
fi

# HOME: xdm sets it from the passwd entry. root's entry is "/" (no home
# under /Users), so give root /var/root as before; any other user whose home
# is missing or unwritable gets a private directory under /tmp so wmaker and
# GNUstep can write their state.
case "$HOME" in
/|"")
    if [ "`id -u`" = 0 ]; then HOME=/var/root; fi
    ;;
esac
mkdir -p "$HOME" 2>/dev/null
if [ ! -d "$HOME" ] || [ ! -w "$HOME" ]; then
    HOME=/tmp/home-`id -u`
    ( umask 077; mkdir -p "$HOME" )
fi
export HOME

# Session log, as upstream's Xsession.in does (~/.xsession-errors), falling
# back to a per-uid file in /tmp.
errfile="$HOME/.xsession-errors"
if ( umask 077 && cp /dev/null "$errfile" 2>/dev/null ); then
    exec > "$errfile" 2>&1
else
    errfile=/tmp/xsession-errors-`id -u`
    if ( umask 077 && cp /dev/null "$errfile" 2>/dev/null ); then
        exec > "$errfile" 2>&1
    else
        exec > /dev/null 2>&1
    fi
fi

export PATH=/usr/X11/bin:/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin
[ -n "$DISPLAY" ] || export DISPLAY=:0

# GNUstep.sh (gnustep-make) reads GNUSTEP_CONFIG_FILE; it sets the
# GNUSTEP_* paths and library paths apps need.
export GNUSTEP_CONFIG_FILE=/etc/GNUstep/GNUstep.conf
if [ -f /System/Library/Makefiles/GNUstep.sh ]; then
    . /System/Library/Makefiles/GNUstep.sh
fi

# Upstream Xsession.in: a user's own ~/.xsession replaces the default.
startup="$HOME/.xsession"
if [ -s "$startup" ]; then
    if [ -x "$startup" ]; then
        exec "$startup"
    else
        exec /bin/sh "$startup"
    fi
fi

# Session choice: first word of /etc/x11-session.wm; missing or anything
# other than "gershwin" means Window Maker.
wm=wmaker
[ -r /etc/x11-session.wm ] && read wm _ < /etc/x11-session.wm
case "$wm" in
gershwin)
    GWM=/System/Library/CoreServices/Applications/WindowManager.app/WindowManager
    GWS=/Applications/GWorkspace.app/GWorkspace
    if [ -x "$GWM" ] && [ -x "$GWS" ]; then
        # GWorkspace is the session leader, as in a GNUstep desktop session:
        # its Logout command quits it, which ends this script and so the
        # xdm session (there is no logout menu in the WM itself). The WM runs
        # beside it, started first so the apps find it already managing the
        # root; compositing is off by default (the WM's -ec turns it on).
        "$GWM" &
        sleep 3
        T=/Applications/Terminal.app/Terminal
        [ -x "$T" ] && "$T" &
        exec "$GWS"
    fi
    if [ -x "$GWM" ]; then
        # No GWorkspace on the image: the WM alone, Terminal as the autostart.
        T=/Applications/Terminal.app/Terminal
        [ -x "$T" ] && "$T" &
        exec "$GWM"
    fi
    echo "Xsession: $GWM missing, falling back to wmaker"
    ;;
esac
exec /usr/X11/bin/wmaker
