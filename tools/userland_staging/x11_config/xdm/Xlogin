! Xlogin: the greeter's resources, installed as
! /usr/X11/share/X11/app-defaults/Xlogin (see xdm-config for why not xrdb).
! Adapted from third_party/xdm/config/Xresources.in (xdm-1.1.17) with the
! cpp conditionals resolved for a colour display >= 8 planes and with
! Xft faces only (the image has no core X fonts; xdm is built USE_XFT).
! Colours are hex, not names, so nothing depends on an rgb.txt.
Xcursor.theme: whiteglass

xlogin*login.translations: #override \
	Ctrl<Key>R: abort-display()\n\
	<Key>F1: set-session-argument(failsafe) finish-field()\n\
	<Key>Delete: delete-character()\n\
	<Key>Left: move-backward-character()\n\
	<Key>Right: move-forward-character()\n\
	<Key>Home: move-to-begining()\n\
	<Key>End: move-to-end()\n\
	Ctrl<Key>KP_Enter: set-session-argument(failsafe) finish-field()\n\
	<Key>KP_Enter: set-session-argument() finish-field()\n\
	Ctrl<Key>Return: set-session-argument(failsafe) finish-field()\n\
	<Key>Return: set-session-argument() finish-field()

xlogin*greeting: Welcome to Darwin on Raspberry Pi
xlogin*namePrompt: \040\040\040\040\040\040\040Login:
xlogin*fail: Login incorrect or forbidden by policy

xlogin*greetFace:	DejaVu Sans-22:bold
xlogin*face:		DejaVu Sans-16
xlogin*promptFace:	DejaVu Sans-16:bold
xlogin*failFace:	DejaVu Sans-16:bold

xlogin*borderWidth: 1
xlogin*frameWidth: 5
xlogin*innerFramesWidth: 2
xlogin*shdColor: #4d4d4d
xlogin*hiColor: #e5e5e5
xlogin*background: #bebebe
xlogin*inpColor: #cccccc
xlogin*greetColor: #0000cd
xlogin*failColor: #ff0000
xlogin*foreground: #000000

xlogin*logoFileName: /usr/X11/lib/X11/xdm/pixmaps/xorg.xpm
xlogin*useShape: true
xlogin*logoPadding: 10
