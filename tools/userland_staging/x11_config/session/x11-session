#!/bin/sh
# /usr/X11/bin/x11-session: the X session launchd keeps running at boot
# (org.puredarwin.x11-session.plist): Xorg on the HDMI framebuffer, then
# Window Maker, with the GNUstep environment set so GNUstep apps start
# from wmaker (see autostart, which opens Terminal.app).
#
# It exits when wmaker exits or Xorg dies; launchd (KeepAlive) then starts
# a fresh session. Touch /etc/x11-session.disabled to turn it off: the
# job then exits 0 at once and the console login is unaffected.
# Xorg needs the USB mouse plugged in before boot (DAR-442).

[ -e /etc/x11-session.disabled ] && exit 0

export HOME="${HOME:-/var/root}"
mkdir -p "$HOME" 2>/dev/null
export PATH=/usr/X11/bin:/usr/GNUstep/System/Tools:/bin:/usr/bin:/sbin:/usr/sbin
export DISPLAY=:0

# GNUstep.sh (gnustep-make) reads GNUSTEP_CONFIG_FILE; it sets the
# GNUSTEP_* paths and library paths apps need.
export GNUSTEP_CONFIG_FILE=/etc/GNUstep/GNUstep.conf
if [ -f /usr/GNUstep/System/Library/Makefiles/GNUstep.sh ]; then
    . /usr/GNUstep/System/Library/Makefiles/GNUstep.sh
fi

rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
/usr/X11/bin/Xorg :0 -nolisten tcp > /var/log/Xorg.out 2>&1 &
XPID=$!

# Wait for the server's socket (up to 60 s); give up if Xorg exits first.
n=0
while [ ! -S /tmp/.X11-unix/X0 ]; do
    kill -0 "$XPID" 2>/dev/null || { echo "x11-session: Xorg exited, see /var/log/Xorg.out" >&2; exit 1; }
    n=$((n + 1))
    [ "$n" -gt 120 ] && { echo "x11-session: Xorg socket did not appear" >&2; kill "$XPID"; exit 1; }
    sleep 0.5
done

/usr/X11/bin/wmaker > /var/log/wmaker.out 2>&1
kill "$XPID" 2>/dev/null
exit 0
