<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.puredarwin.x11-session</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/X11/bin/xdm-launch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart only after a failure. xdm-launch exits 0 without starting
	     anything when the kernel boot-args lack hdmi_console=1 (plain QEMU,
	     no framebuffer) or /etc/x11-session.disabled exists; a plain
	     KeepAlive=true would respawn that every ThrottleInterval. A
	     nonzero exit (xdm crash, exec failure) is still retried. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/var/log/x11-session.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/x11-session.log</string>
</dict>
</plist>
