<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Bring up the on-board Bluetooth controller at boot
	(docs/bluetooth-plan.md): power, patch, speed switch; then hand it to
	the kernel's Bluetooth stack (netbt, docs/bluetooth-stack-plan.md):
	`btconfig bcmbt0 up pscan` enables HCI unit bcmbt0, which the driver
	attached after `bt up`, makes it connectable (page scan), so paired
	keyboards and mice can reconnect to it, and turns on Secure Simple
	Pairing (bthcid is the agent; devices without SSP still pair with a PIN).

	With /etc/bluetooth.off (Bluetooth turned off in the menu bar or
	Settings, btsetup(8)) the controller is brought up but the unit is left
	down.

	Does nothing unless the kernel was booted with bt=1 (otherwise there is
	no BCM43430Bluetooth service and `bt info` fails), and skips `bt up`
	when the controller is already up (the job was re-run).

	RunAtLoad, no KeepAlive. Output goes to a file for the reason every
	project plist documents (DAR-257/DAR-167): launchd never wires an
	unconfigured job's stdio to /dev/console.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.puredarwin.bluetooth</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/sbin/bt info >/dev/null 2>&amp;1 || exit 0; /usr/sbin/bt info | grep -q '^state: *up$' || /usr/sbin/bt up || exit 1; [ -x /usr/sbin/btconfig ] || exit 0; [ -f /etc/bluetooth.off ] &amp;&amp; exit 0; exec /usr/sbin/btconfig bcmbt0 up pscan ssp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/bluetooth.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/bluetooth.log</string>
</dict>
</plist>
