--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/usr/lib/libobjc.A.dylib'
current-version: 0
compatibility-version: 0
exports:
  - targets:         [ arm64-ios ]
    symbols:         [ ___objc_personality_v0, __objc_atfork_child, __objc_atfork_parent,
                       __objc_atfork_prepare, __objc_empty_cache, __objc_init,
                       _class_createInstance, _objc_autoreleasePoolPop,
                       _objc_autoreleasePoolPush, _objc_begin_catch, _objc_destructInstance, _objc_end_catch,
                       _objc_lookUpClass, _objc_msgSend, _objc_msgSendSuper2,
                       _objc_opt_class, _objc_release, _objc_retain, _objc_terminate,
                       _object_getClassName ]
    objc-classes:    [ NSObject ]
...
