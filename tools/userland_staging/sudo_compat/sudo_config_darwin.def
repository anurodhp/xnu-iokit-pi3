# Hand-derived Darwin/arm64 answers for third_party/sudo (v1.9.5p2)
# config.h.in (DAR-340). Consumed by ../gen_sudo_config_h.sh: every name
# here MUST exist as an `#undef` in config.h.in (the generator hard-fails
# on a typo); every `#undef` not named here becomes `/* #undef X */`.
# Format: NAME<space>VALUE   (VALUE is pasted verbatim after #define).
#
# STATUS: UNVERIFIED against a real compile -- written on a Linux host
# with no Xcode/SDK. Sections say what each answer rests on:
#   [cfg]  upstream configure.ac's own default or its `*-*-darwin*` case
#          (configure.ac:179-287 defaults, :2270-2300 Darwin branch)
#   [sdk]  standard Darwin/macOS SDK fact -- re-check with the Xcode 12
#          iPhoneOS SDK headers
#   [libc] a function this project's curated libsystem_c must EXPORT --
#          confirm with tools/userland_staging/gap_audit.sh
# Policy: where upstream ships a portable fallback in lib/util/ (gated by
# `#ifndef HAVE_X`), the symbol is left UNDEFINED here on purpose, so the
# fallback compiles in and no new libsystem bind is needed. See
# build_sudo.sh's header.

# ---- build shape ----
ENABLE_SUDO_PLUGIN_API 1
STATIC_SUDOERS_PLUGIN 1
# No PAM (configure.ac:2276 -- Darwin excludes PAM by default anyway),
# no login_cap, no BSM audit, no LDAP/SSSD, no openssl/zlib, no
# sudo_logsrvd client (SUDOERS_LOG_CLIENT left undefined).

# ---- [cfg] compile-time defaults (configure.ac:179-287) ----
ENV_RESET 1
ENV_EDITOR 1
EDITOR "vi"
LOGGING SLOG_SYSLOG
LOGFAC "auth"
PRI_SUCCESS "notice"
PRI_FAILURE "alert"
MAXLOGFILELEN 80
MAILTO "root"
MAILSUBJECT "*** SECURITY information for %h ***"
INCORRECT_PASSWORD "Sorry, try again."
PASSPROMPT "Password: "
PASSWORD_TIMEOUT 5
TIMEOUT 5
TRIES_FOR_PASSWORD 3
SUDO_UMASK 0022
RUNAS_DEFAULT "root"
TIMESTAMP_TYPE tty
SEND_MAIL_WHEN_NO_USER 1
SHELL_IF_NO_ARGS 1
SHELL_SETS_HOME 1
os_init os_init_common
RTLD_PRELOAD_VAR "DYLD_INSERT_LIBRARIES"
RTLD_PRELOAD_DELIM ":"
NO_PAM_SESSION 1
# Auth: plugins/sudoers/auth/passwd.c (getpwnam + crypt) is the only
# backend; nothing here defines WITHOUT_PASSWD.

# ---- [sdk] types / sizes (LP64 arm64) ----
GETGROUPS_T int
SIZEOF_ID_T 4
SIZEOF_LONG_LONG 8
SIZEOF_TIME_T 8
MAX_UID_T_LEN 10
STDC_HEADERS 1
HAVE___FUNC__ 1
HAVE__BOOL 1
HAVE_STDBOOL_H 1
HAVE_LONG_LONG_INT 1
HAVE_UNSIGNED_LONG_LONG_INT 1
HAVE_FALLTHROUGH_ATTRIBUTE 1
HAVE_DSO_VISIBILITY 1

# ---- [sdk] headers ----
HAVE_DIRENT_H 1
HAVE_DLFCN_H 1
HAVE_INTTYPES_H 1
HAVE_MACHINE_ENDIAN_H 1
HAVE_PATHS_H 1
HAVE_STDINT_H 1
HAVE_STDLIB_H 1
HAVE_STRINGS_H 1
HAVE_STRING_H 1
HAVE_SYS_SELECT_H 1
HAVE_SYS_SOCKIO_H 1
HAVE_SYS_STAT_H 1
HAVE_SYS_TYPES_H 1
HAVE_UNISTD_H 1
HAVE_UTIL_H 1
HAVE_UTMPX_H 1
HAVE_PTHREAD_H 1
# HAVE_LIBUTIL_H / HAVE_LOGIN_CAP_H / HAVE_SYS_SYSMACROS_H: not Darwin.

# ---- [sdk] declarations ----
HAVE_DECL_ERRNO 1
HAVE_DECL_GETDELIM 1
HAVE_DECL_GETDOMAINNAME 1
HAVE_DECL_H_ERRNO 1
HAVE_DECL_INNETGR 1
HAVE_DECL_LLONG_MAX 1
HAVE_DECL_LLONG_MIN 1
HAVE_DECL_PATH_MAX 1
HAVE_DECL_QUAD_MAX 1
HAVE_DECL_QUAD_MIN 1
HAVE_DECL_SIZE_MAX 1
HAVE_DECL_SIZE_T_MAX 1
HAVE_DECL_ULLONG_MAX 1
HAVE_DECL_UQUAD_MAX 1

# ---- [sdk] struct members ----
HAVE_STRUCT_DIRENT_D_NAMLEN 1
HAVE_STRUCT_DIRENT_D_TYPE 1
HAVE_STRUCT_IN6_ADDR 1
HAVE_STRUCT_SOCKADDR_IN_SIN_LEN 1
HAVE_STRUCT_SOCKADDR_SA_LEN 1
HAVE_STRUCT_TM_TM_GMTOFF 1
HAVE_ST_MTIMESPEC 1
HAVE_KINFO_PROC_44BSD 1
HAVE_STRUCT_UTMP_UT_ID 1
HAVE_STRUCT_UTMP_UT_PID 1
HAVE_STRUCT_UTMP_UT_TV 1
HAVE_STRUCT_UTMP_UT_TYPE 1
HAVE_STRUCT_UTMP_UT_USER 1

# ---- [libc] functions sudo has NO fallback for, or must use natively ----
HAVE_CRYPT 1
HAVE_DLOPEN 1
HAVE_DIRFD 1
HAVE_EXECVP 1
HAVE_FSEEKO 1
HAVE_GETADDRINFO 1
HAVE_GETGROUPS 1
HAVE_GETGROUPLIST 1
HAVE_GETIFADDRS 1
HAVE_FREEIFADDRS 1
HAVE_GETPROGNAME 1
HAVE_GETTTYENT 1
HAVE_GETUTXID 1
HAVE_GRANTPT 1
HAVE_POSIX_OPENPT 1
HAVE_INNETGR 1
HAVE_KILLPG 1
HAVE_LRAND48 1
HAVE_OPTRESET 1
HAVE_PSELECT 1
HAVE_PTHREAD_ATFORK 1
HAVE_REVOKE 1
HAVE_SETEUID 1
HAVE_SETREUID 1
HAVE_SYSCTL 1
HAVE_UNSETENV 1
HAVE_FUTIMES 1
HAVE_UTIMES 1
HAVE_MACH_CONTINUOUS_TIME 1
# Native libc printf family / string helpers (Apple Libc's own):
HAVE_ASPRINTF 1
HAVE_VASPRINTF 1
HAVE_SNPRINTF 1
HAVE_VSNPRINTF 1
HAVE_VSYSLOG 1
HAVE_STRLCAT 1
HAVE_STRLCPY 1
HAVE_STRNDUP 1
HAVE_STRNLEN 1
HAVE_STRSIGNAL 1
HAVE_BZERO 1
HAVE_ISBLANK 1
HAVE_MKDTEMP 1
HAVE_FNMATCH 1
HAVE_GLOB 1
HAVE_GETDELIM 1
HAVE_GETUSERSHELL 1
HAVE_INET_NTOP 1
HAVE_INET_PTON 1
HAVE_NANOSLEEP 1
HAVE_PREAD 1
HAVE_PWRITE 1
HAVE_ARC4RANDOM 1
HAVE_ARC4RANDOM_BUF 1
HAVE_ARC4RANDOM_UNIFORM 1
HAVE_GETENTROPY 1
# Deliberately UNDEFINED so upstream's fallback compiles in (each gated
# `#ifndef HAVE_X` in lib/util/): openat fstatat unlinkat fchmodat
# reallocarray memrchr closefrom explicit_bzero freezero getopt_long
# pw_dup sig2str str2sig pipe2 dup3 futimens utimensat mkstemps
# clock_gettime cfmakeraw. Also undefined: HAVE_POLL (configure.ac:2279,
# "Darwin has a broken poll()"), HAVE___INTERPOSE (only for
# sudo_noexec.so, not built), HAVE_DECL_SYS_SIGLIST (sudo generates its
# own via mksiglist/mksigname -- see build_sudo.sh).
