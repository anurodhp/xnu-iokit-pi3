# Darwin answers for third_party/sudo's pathnames.h.in (DAR-340), consumed
# by ../gen_sudo_config_h.sh exactly like sudo_config_darwin.def.
# Layout follows this project's /etc + /var conventions; configure.ac's
# own defaults (devsearch, sesh/noexec under $libexecdir/sudo) otherwise.
# _PATH_SUDO_SENDMAIL is left UNDEFINED on purpose: no MTA exists here,
# and eventlog.c:94 / defaults.c:590 both guard on it.
_PATH_SUDO_TIMEDIR "/var/db/sudo/ts"
_PATH_SUDO_LECTURE_DIR "/var/db/sudo/lectured"
_PATH_SUDO_IO_LOGDIR "/var/log/sudo-io"
_PATH_SUDO_LOGDIR "/var/log"
_PATH_SUDO_LOGFILE "/var/log/sudo.log"
_PATH_SUDO_NOEXEC "/usr/libexec/sudo/sudo_noexec.so"
_PATH_SUDO_ASKPASS ""
_PATH_SUDO_PLUGIN_DIR "/usr/libexec/sudo"
_PATH_SUDO_DEVSEARCH "/dev/pts:/dev/vt:/dev/term:/dev/zcons:/dev/pty:/dev"
_PATH_SUDO_SESH "/usr/libexec/sudo/sesh"
_PATH_VI "/usr/bin/vi"
_PATH_MV "/bin/mv"
