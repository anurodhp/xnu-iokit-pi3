<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DAR-439 test job (tools/wm_qos_verify_guest.sh): same ProcessType as
     org.puredarwin.x11-session.plist. Test image only, never shipped. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.puredarwin.qostest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/var/root/qos_job.sh</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/qostest.out</string>
	<key>StandardErrorPath</key>
	<string>/var/log/qostest.out</string>
</dict>
</plist>
