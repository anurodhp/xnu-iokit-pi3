# Vendored reference clones (each has its own git history/repo)
/third_party/

# Build intermediates
devicetrees/*.p
__pycache__/
tools/init_binary/init.macho
tools/userland_staging/*.o
tools/userland_staging/*.macho
tools/userland_staging/libsyscall_smoketest/*.o
# Regenerated by build_libc_string.sh (compiled objects + a handful of
# FreeBSD source files fetched fresh each run, not vendored - see that
# script's own header comment for why/which files).
tools/userland_staging/libc_build/

# Downloaded precompiled binaries and local QEMU test scaffolding -
# large, reproducible, not our source (precompiled/rpi.dtb is also known-bad,
# see project memory)
/precompiled/
/qemu/

# Same reasoning as precompiled/ above - reproducible copies/downloads
# staged for a real SD card, not our source. Only config.txt and README.md
# (this project's own authored content) are tracked from sdcard/.
sdcard/*.bin
sdcard/*.elf
sdcard/*.dat
sdcard/*.dtb
sdcard/kernel.development.bcm2837.unstripped

# tools/sdhci_baremetal build output/test artifacts - regeneratable via
# build.sh/run_qemu.sh, not source. sdcard.img in particular is a 2GiB+
# sparse test image.
tools/sdhci_baremetal/*.o
tools/sdhci_baremetal/*.bin
tools/sdhci_baremetal/*.elf
tools/sdhci_baremetal/sdcard.img
tools/sdhci_baremetal/mon.sock
tools/sdhci_baremetal/*.log
