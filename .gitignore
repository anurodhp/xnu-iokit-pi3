# Vendored reference clones (each has its own git history/repo)
/third_party/

# Build intermediates
devicetrees/*.p
__pycache__/
tools/init_binary/init.macho
tools/userland_staging/*.o
tools/userland_staging/*.macho
tools/userland_staging/libsyscall_smoketest/*.o
# Regenerated by build_libc_string.sh (compiled objects + a handful of
# FreeBSD source files fetched fresh each run, not vendored - see that
# script's own header comment for why/which files).
tools/userland_staging/libc_build/
# Regenerated by build_bash_survey.sh (compiled .o + clang stderr per
# surveyed bash-3.2 core file - see that script's own header comment).
tools/userland_staging/bash_survey_out/
# Regenerated by build_bash.sh (compiled .o/.err per file, generated
# host tools mksyntax/sys_stubs, compat include shims) - see that
# script's own header comment.
tools/userland_staging/bash_build/
# Regenerated by build_icu_host.sh (full native host ICU build tree --
# config, object files, generated data/tools - see that script's own
# header comment for why this is stage 1 of a two-stage cross build).
tools/userland_staging/icu_build/
tools/libinfo_custom/host_test
tools/libinfo_custom/crypt_des_host_test
tools/libinfo_custom/*.o

# Phase 5 provisioning tool -- build artifact, rebuild via
# tools/pwtool/build.py (same reasoning as init.macho above)
tools/pwtool/pwtool.macho
tools/pwtool/host_test
tools/pwtool/*.o

# Phase 5 login host test binary, same reasoning
tools/init_binary/host_test

# Phase 7.5 real-bsdthread_create smoke test -- build artifact, rebuild via
# tools/pthread_kthread_test/build.py (same reasoning as init.macho above)
tools/pthread_kthread_test/pthread_kthread_test.macho

# Phase 7.5 real workq_* thread-stack hooks smoke test -- build artifact,
# rebuild via tools/workq_kthread_test/build.py (same reasoning as
# init.macho above)
tools/workq_kthread_test/workq_kthread_test.macho

# Phase 7.5 real ulock_wait/ulock_wake blocking-handoff smoke test -- build
# artifact, rebuild via tools/ulock_kthread_test/build.py (same reasoning as
# init.macho above)
tools/ulock_kthread_test/ulock_kthread_test.macho

# Downloaded precompiled binaries and local QEMU test scaffolding -
# large, reproducible, not our source (precompiled/rpi.dtb is also known-bad,
# see project memory)
/precompiled/
/qemu/

# Same reasoning as precompiled/ above - reproducible copies/downloads
# staged for a real SD card, not our source. Only config.txt and README.md
# (this project's own authored content) are tracked from sdcard/.
sdcard/*.bin
sdcard/*.elf
sdcard/*.dat
sdcard/*.dtb
sdcard/kernel.development.bcm2837.unstripped

# tools/sdhci_baremetal build output/test artifacts - regeneratable via
# build.sh/run_qemu.sh, not source. sdcard.img in particular is a 2GiB+
# sparse test image.
tools/sdhci_baremetal/*.o
tools/sdhci_baremetal/*.bin
tools/sdhci_baremetal/*.elf
tools/sdhci_baremetal/sdcard.img
tools/sdhci_baremetal/mon.sock
tools/sdhci_baremetal/*.log
