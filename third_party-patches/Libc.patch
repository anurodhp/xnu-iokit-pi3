From 3c9df1a4e2b7d0f6a58c1e2934bb7f0512a6e903 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Thu, 03 Sep 2026 12:00:00 -0400
Subject: [PATCH 3/3] collate.c: widen __collate_collating_symbol/
 __collate_equiv_class to default visibility

Real Apple source marks both __private_extern__ (this file's own header
comment already explains most __collate_* routines are __private_extern__
by design, with grep(1) as the one historical exception kept public). On
real macOS this is fine because real Apple's own fnmatch.c (the only
caller of these two outside this file) is compiled into the SAME image,
libsystem_c.dylib, so a private-extern (same-image-only) bind is exactly
correct there.

iokit/xnu-rpi3 (this project) is not that: fnmatch.c is compiled
separately, into each consumer's own static extras archive (see
build_launchctl.sh's liblaunchctl_extras.a), so a cross-image reference
needs the real, canonical definition (the one that ships inside
libsystem_c.dylib, via build_libc_locale.sh) to actually be exported --
same real "private-extern reference can't bind across a dylib boundary"
mechanism as xlocale_private.h's own __global_locale/__locale_key, and
the identical macro-gated-widening fix shape: only build_libc_locale.sh's
own compile (the one real Apple canonical definition that ends up in
libsystem_c.dylib) sets COLLATE_STATE_EXPORTED; every other reference to
this header stays default (still __private_extern__, matching real
Apple). Unlike the xlocale pair, no other project-authored file
redefines these two symbols anywhere (confirmed via grep across
third_party/Libc and tools/userland_staging), so there is no equivalent
duplicate-export risk from a second, independent producer.

Real bug this closes: build_launchctl.sh's liblaunchctl_extras.a compiles
real fnmatch.c directly (needed for launchctl.c's own path_goodness_check/
empty_dir), and fnmatch.o's _rangematch calls both symbols. Before this
fix they were undefined at launchctl.macho's link (exported by no dylib
in the stack). See docs/static-linking-cleanup-plan.md's DAR-234 entry
for the full investigation.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 locale/FreeBSD/collate.c | 36 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/locale/FreeBSD/collate.c b/locale/FreeBSD/collate.c
index 0000000..0000000 100644
--- a/locale/FreeBSD/collate.c
+++ b/locale/FreeBSD/collate.c
@@ -665,7 +665,37 @@
  * STR_LEN or if dlen is too small.  It is up to the calling routine to
  * preserve the mbstate_t structure as needed.
  */
+/* __collate_collating_symbol/__collate_equiv_class: real Apple source
+ * marks both __private_extern__ (this file's own header comment above
+ * already explains most __collate_* routines are __private_extern__ by
+ * design, with grep(1) as the one historical exception kept public) --
+ * on real macOS this is fine because real Apple's own fnmatch.c (the
+ * only caller of these two outside this file) is compiled into the SAME
+ * image, libsystem_c.dylib, so a private-extern (same-image-only) bind
+ * is exactly correct there. iokit/xnu-rpi3 (this project) is not that:
+ * fnmatch.c is compiled separately, into each consumer's own static
+ * extras archive (see build_launchctl.sh's liblaunchctl_extras.a), so a
+ * cross-image reference needs the real, canonical definition (the one
+ * that ships inside libsystem_c.dylib, via build_libc_locale.sh) to
+ * actually be exported -- same real "private-extern reference can't
+ * bind across a dylib boundary" mechanism as xlocale_private.h's own
+ * __global_locale/__locale_key (see that header's own comment,
+ * XLOCALE_STATE_EXPORTED), and the identical macro-gated-widening fix
+ * shape: only build_libc_locale.sh's own compile (the one real Apple
+ * canonical definition that ends up in libsystem_c.dylib) sets
+ * COLLATE_STATE_EXPORTED; every other reference to this header stays
+ * default (still __private_extern__, matching real Apple). Unlike the
+ * xlocale pair, no other project-authored file redefines these two
+ * symbols anywhere (confirmed via grep across third_party/Libc and
+ * tools/userland_staging), so there is no equivalent duplicate-export
+ * risk from a second, independent producer -- still gated behind a
+ * macro rather than widened unconditionally, for the same auditability
+ * reason established there. DAR-234, 2026-09-03. */
+#ifdef COLLATE_STATE_EXPORTED
+size_t
+#else
 __private_extern__ size_t
+#endif
 __collate_collating_symbol(wchar_t *dst, size_t dlen, const char *src, size_t slen, mbstate_t *ps, locale_t loc)
 {
 	wchar_t wname[STR_LEN];
@@ -738,7 +768,11 @@
  * is greater or equal to STR_LEN in length.  It is up to the calling
  * routine to preserve the mbstate_t structure as needed.
  */
+#ifdef COLLATE_STATE_EXPORTED
+int
+#else
 __private_extern__ int
+#endif
 __collate_equiv_class(const char *src, size_t slen, mbstate_t *ps, locale_t loc)
 {
 	wchar_t wname[STR_LEN];
