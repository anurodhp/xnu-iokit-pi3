From 5715b046fb277c1b73faf05d477642192515f5d3 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Wed, 26 Aug 2026 08:35:58 -0400
Subject: [PATCH 1/3] Move dispatch_pthread_root_queue_observer_hooks_s typedef
 earlier

Real, upstream ordering bug: dispatch_workloop_attr_s (line ~468) embeds
a dispatch_pthread_root_queue_observer_hooks_s member by value, but the
typedef itself wasn't defined until ~190 lines later in the same file --
an incomplete type used by value, illegal in C regardless of platform.
Moves the typedef immediately after dispatch_queue_specific_head_t
(before its first use) and removes the now-duplicate later definition.

Found while porting this library for real (not the project's minimal
single-thread shim) to iokit's Raspberry Pi 3 XNU port -- confirmed via a
real arm64-apple-ios14.4 clang -fsyntax-only trial compile, not assumed.
---
 src/queue_internal.h | 15 +++++++--------
 1 file changed, 7 insertions(+), 8 deletions(-)

diff --git a/src/queue_internal.h b/src/queue_internal.h
index d9425fc..03fc366 100644
--- a/src/queue_internal.h
+++ b/src/queue_internal.h
@@ -457,6 +457,13 @@ typedef struct dispatch_queue_specific_head_s {
 	TAILQ_HEAD(, dispatch_queue_specific_s) dqsh_entries;
 } *dispatch_queue_specific_head_t;
 
+typedef struct dispatch_pthread_root_queue_observer_hooks_s {
+	void (*queue_will_execute)(dispatch_queue_t queue);
+	void (*queue_did_execute)(dispatch_queue_t queue);
+} dispatch_pthread_root_queue_observer_hooks_s;
+typedef dispatch_pthread_root_queue_observer_hooks_s
+		*dispatch_pthread_root_queue_observer_hooks_t;
+
 #define DISPATCH_WORKLOOP_ATTR_HAS_SCHED      0x0001u
 #define DISPATCH_WORKLOOP_ATTR_HAS_POLICY     0x0002u
 #define DISPATCH_WORKLOOP_ATTR_HAS_CPUPERCENT 0x0004u
@@ -650,14 +657,6 @@ struct dispatch_queue_global_s {
 	DISPATCH_QUEUE_ROOT_CLASS_HEADER(lane);
 } DISPATCH_CACHELINE_ALIGN;
 
-
-typedef struct dispatch_pthread_root_queue_observer_hooks_s {
-	void (*queue_will_execute)(dispatch_queue_t queue);
-	void (*queue_did_execute)(dispatch_queue_t queue);
-} dispatch_pthread_root_queue_observer_hooks_s;
-typedef dispatch_pthread_root_queue_observer_hooks_s
-		*dispatch_pthread_root_queue_observer_hooks_t;
-
 #ifdef __APPLE__
 #define DISPATCH_IOHID_SPI 1
 
