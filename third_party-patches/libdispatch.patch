From 96f56513edff4db9c6e8b6f7e27b76f27a27fac2 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Wed, 26 Aug 2026 09:06:52 -0400
Subject: [PATCH 3/3] Fix real event_kevent.c param typo; add missing init.c
 global keys; cast for C++ compat

event_kevent.c: _dispatch_kq_create's #else branch referenced 'guard_ptr',
but the actual parameter is named 'fd_ptr' -- a real upstream typo, only
hit when DISPATCH_USE_GUARDED_FD is off (this project's curated libc has
no guarded_kqueue_np).

init.c: queue.c's real _dispatch_once_f-based key init calls
_dispatch_thread_key_create(&dispatch_priority_key, ...) and
&dispatch_r2k_key unconditionally, but init.c's own portable
(!DISPATCH_USE_DIRECT_TSD) global list never declared either --
confirmed real omission in this exact vendored tag, not a config issue.

shims/tsd.h: _dispatch_thread_port()'s portable body passed a uintptr_t
where pthread_mach_thread_np() wants pthread_t -- C tolerates the
implicit conversion, C++ (needed once block.cpp entered the real build)
does not. Explicit cast, no behavior change.
---
 src/event/event_kevent.c | 2 +-
 src/init.c               | 2 ++
 src/shims/tsd.h          | 2 +-
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/event/event_kevent.c b/src/event/event_kevent.c
index b89e4d0..f83146a 100644
--- a/src/event/event_kevent.c
+++ b/src/event/event_kevent.c
@@ -603,7 +603,7 @@ _dispatch_kq_create(intptr_t *fd_ptr)
 	guardid_t guard = (uintptr_t)fd_ptr;
 	kqfd = guarded_kqueue_np(&guard, GUARD_CLOSE | GUARD_DUP);
 #else
-	(void)guard_ptr;
+	(void)fd_ptr;
 	kqfd = kqueue();
 #endif
 	if (kqfd == -1) {
diff --git a/src/init.c b/src/init.c
index ff2b5b6..f1543a8 100644
--- a/src/init.c
+++ b/src/init.c
@@ -127,6 +127,8 @@ DWORD __dispatch_tsd_key;
 pthread_key_t __dispatch_tsd_key;
 #endif
 #elif !DISPATCH_USE_DIRECT_TSD
+pthread_key_t dispatch_priority_key;
+pthread_key_t dispatch_r2k_key;
 pthread_key_t dispatch_queue_key;
 pthread_key_t dispatch_frame_key;
 pthread_key_t dispatch_cache_key;
diff --git a/src/shims/tsd.h b/src/shims/tsd.h
index 2207d4c..d1f3a8b 100644
--- a/src/shims/tsd.h
+++ b/src/shims/tsd.h
@@ -329,7 +329,7 @@ _dispatch_thread_setspecific_packed_pair(pthread_key_t k1, pthread_key_t k2,
 #define _dispatch_thread_port() ((mach_port_t)(uintptr_t)\
 		_dispatch_thread_getspecific(_PTHREAD_TSD_SLOT_MACH_THREAD_SELF))
 #else
-#define _dispatch_thread_port() pthread_mach_thread_np(_dispatch_thread_self())
+#define _dispatch_thread_port() pthread_mach_thread_np((pthread_t)_dispatch_thread_self())
 #endif
 #endif
 
-- 
