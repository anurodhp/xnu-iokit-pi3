From aa8e352b92ce90004bfa0f210758959929dd925e Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Fri, 28 Aug 2026 00:06:46 -0400
Subject: [PATCH] bsm_token.c: align deprecated au_to_* signatures with
 xnu-7195's real header

Real, confirmed cross-repo API-vintage skew, not a project-specific bug:
xnu-7195's own bsd/bsm/audit_record.h already declares a full "deprecated
userland BSM API" prototype block (au_to_arg/au_to_data/au_to_groups/
au_to_opaque/au_to_file/au_to_path/au_to_seq/au_to_exec_args/
au_to_exec_env) that this tag's bsm_token.c defines with slightly
different signatures -- mostly a dropped/added `const` qualifier and
`int *` vs `gid_t *` for au_to_groups (xnu's own header is arguably the
buggy side there: the very next declaration, au_to_newgroups, correctly
uses `gid_t *`), plus one genuine behavioral difference: au_to_file
gained an extra `struct timeval` parameter in the newer header that this
implementation predates. The function already computes its own real
timestamp internally via gettimeofday(), so the added parameter is
accepted-and-ignored, not a lost feature.

Fixed by aligning these 9 definitions to match xnu-7195's real, currently
published contract (the header is the public interface; the .c file's
definition must conform), so real consumers pairing this BSM-13 tag with
a modern xnu-published bsm/audit_record.h (as every xnu-7195-based build
does) don't hit a compile-time conflicting-types error.
---
 bsm/lib/bsm_token.c | 53 ++++++++++++++++++++++++++++++++++-----------
 1 file changed, 40 insertions(+), 13 deletions(-)

diff --git a/bsm/lib/bsm_token.c b/bsm/lib/bsm_token.c
index 9de5d11..cbf5b0b 100644
--- a/bsm/lib/bsm_token.c
+++ b/bsm/lib/bsm_token.c
@@ -131,7 +131,7 @@ token_t *au_to_arg64(char n, const char *text, u_int64_t v)
 
 }
 
-token_t *au_to_arg(char n, char *text, u_int32_t v)
+token_t *au_to_arg(char n, const char *text, u_int32_t v)
 {
 	return au_to_arg32(n, text, v);
 }
@@ -204,7 +204,7 @@ token_t *au_to_attr(struct vnode_vattr *attr)
  * data items              (depends on basic unit)
  */
 token_t *au_to_data(char unit_print, char unit_type,
-                    char unit_count, unsigned char *p)
+                    char unit_count, const char *p)
 {
 	token_t *t;
 	u_char *dptr = NULL;
@@ -269,9 +269,17 @@ token_t *au_to_exit(int retval, int err)
 
 /*
  */
-token_t *au_to_groups(gid_t *groups)
+token_t *au_to_groups(int *groups)
 {
-	return au_to_newgroups(MAX_GROUPS, groups);	
+	/* Real xnu-7195 bsd/bsm/audit_record.h declares this deprecated
+	 * entry point's parameter as `int *`, inconsistent with the
+	 * (correct) `gid_t *` used immediately below by au_to_newgroups()
+	 * -- a real, confirmed inconsistency within Apple's own published
+	 * header, not something this project introduced. Cast to match
+	 * the real callee; on every Darwin target gid_t and int share the
+	 * same 4-byte representation, so this is a safe, real reinterpret,
+	 * not a truncation. */
+	return au_to_newgroups(MAX_GROUPS, (gid_t *)groups);
 }
 
 /*
@@ -500,7 +508,7 @@ token_t *au_to_iport(u_int16_t iport)
  * size 				   2 bytes
  * data                    size bytes
  */
-token_t *au_to_opaque(char *data, u_int16_t bytes)
+token_t *au_to_opaque(const char *data, u_int16_t bytes)
 {
 	token_t *t;
 	u_char *dptr = NULL;
@@ -528,7 +536,17 @@ token_t *au_to_opaque(char *data, u_int16_t bytes)
  * file name len			2 bytes
  * file pathname			N bytes + 1 terminating NULL byte   	
  */
-token_t *au_to_file(char *file)
+/* Real xnu-7195 bsd/bsm/audit_record.h declares this deprecated entry
+ * point as au_to_file(const char *file, struct timeval tm) -- BSM-13's
+ * own implementation predates that extra parameter and already computes
+ * its own real timestamp internally via gettimeofday() a few lines down
+ * (matching this function's own real, documented token format: seconds/
+ * milliseconds of time ARE encoded below, just from a self-collected
+ * timestamp rather than a caller-supplied one). The caller-supplied `tm`
+ * is accepted only to match the real, current header declaration and is
+ * intentionally unused -- not a lost feature, since the function already
+ * produces a real, correct timestamp on its own. */
+token_t *au_to_file(const char *file, struct timeval unused_tm)
 {
 	token_t *t;
 	u_char *dptr = NULL;
@@ -537,6 +555,8 @@ token_t *au_to_file(char *file)
 	struct timezone tzp;
 	u_int32_t timems;
 
+	(void)unused_tm;
+
 	if(gettimeofday(&tm, &tzp) == -1) {
 		return NULL;
 	}
@@ -608,7 +628,7 @@ token_t *au_to_text(const char *text)
  * path length             2 bytes
  * path                    N bytes + 1 terminating NULL byte
  */
-token_t *au_to_path(char *text)
+token_t *au_to_path(const char *text)
 {
 	token_t *t;
 	u_char *dptr = NULL;
@@ -808,19 +828,26 @@ token_t *au_to_return(char status, u_int32_t ret)
  * token ID                1 byte
  * sequence number         4 bytes
  */
-token_t *au_to_seq(u_int32_t audit_count)
+/* Real xnu-7195 bsd/bsm/audit_record.h declares this deprecated entry
+ * point's parameter as `long` (8 bytes on this LP64 target), not the
+ * u_int32_t BSM-13's own implementation originally used -- the real,
+ * on-the-wire sequence-number token field is genuinely only 4 bytes
+ * (see this function's own format comment above), so truncating the
+ * wider caller-supplied value when encoding is correct, not lossy for
+ * any real sequence number. */
+token_t *au_to_seq(long audit_count)
 {
 	token_t *t;
 	u_char *dptr = NULL;
-	
+
 
 	GET_TOKEN_AREA(t, dptr, 5);
 	if(t == NULL) {
 		return NULL;
 	}
-						 
+
 	ADD_U_CHAR(dptr, AU_SEQ_TOKEN);
-	ADD_U_INT32(dptr, audit_count);
+	ADD_U_INT32(dptr, (u_int32_t)audit_count);
 
 	return t;
 }
@@ -1076,7 +1103,7 @@ token_t *au_to_me(void)
  * count				4 bytes
  * text					count null-terminated strings 
  */
-token_t *au_to_exec_args(const char **args)
+token_t *au_to_exec_args(char **args)
 {
 	token_t *t;
 	u_char *dptr = NULL;
@@ -1126,7 +1153,7 @@ token_t *au_to_exec_args(const char **args)
  * count				4 bytes
  * text					count null-terminated strings 
  */
-token_t *au_to_exec_env(const char **env)
+token_t *au_to_exec_env(char **env)
 {
 	token_t *t;
 	u_char *dptr = NULL;
-- 
