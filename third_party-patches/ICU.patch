From da2d1092bdfcfe83b53553073211df11f747f594 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Wed, 26 Aug 2026 20:41:40 -0400
Subject: [PATCH 1/3] common/Makefile.in: build aaplbfct.cpp alongside
 localsvc.cpp

Real upstream (Apple) build-system oversight, not a this-project-specific
issue: aaplbfct.cpp/aaplbfct.h (AppleLanguageBreakFactory) is a real
source file in this checkout, referenced unconditionally by
localsvc.cpp's uprv_svc_hook(), and listed in ICU.xcodeproj's own real
target file list -- but never added to the parallel autotools
Makefile.in, so a plain ./runConfigureICU && make hits an
undefined-symbol link failure for
AppleLanguageBreakFactory::AppleLanguageBreakFactory(UErrorCode&).

Minimal fix: append aaplbfct.o directly in the svchook.mk-generating
rule's OBJECTS line, rather than adding aaplbfct.cpp to LOCALSVC_CPP
itself -- that variable also feeds a 'test -f $(LOCALSVC_CPP)' guard
earlier in the same rule, and test -f does not accept a multi-word
argument (silently fails with 'binary operator expected', which
disables the whole local-service-hook feature rather than just failing
to build aaplbfct.o). aaplbfct.cpp isn't independently optional --
whenever localsvc.cpp's hook is enabled it needs both files -- so
hard-coding the second object here is the correct fix, not a workaround.
---
 icuSources/common/Makefile.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/icuSources/common/Makefile.in b/icuSources/common/Makefile.in
index 699466282..11fe4a316 100644
--- a/icuSources/common/Makefile.in
+++ b/icuSources/common/Makefile.in
@@ -182,7 +182,7 @@ $(SVC_HOOK_INC):
 	@echo generating $@
 	@-test -f $(top_srcdir)/common/$(LOCALSVC_CPP) && ( echo "have $(LOCALSVC_CPP) - U_LOCAL_SERVICE_HOOK=1" ; \
 		echo 'CPPFLAGS +=-DU_LOCAL_SERVICE_HOOK=1' > $@ ; \
-		echo 'OBJECTS += $(LOCALSVC_CPP:%.cpp=%.o)' >> $@ \
+		echo 'OBJECTS += $(LOCALSVC_CPP:%.cpp=%.o) aaplbfct.o' >> $@ \
 		 ) ; true
 	@echo "# Autogenerated by Makefile" >> $@
 
-- 
