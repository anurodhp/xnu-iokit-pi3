From 837fa70dcf16ba4e8e27f7734b37c195f35c4455 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Sat, 22 Aug 2026 12:44:32 -0400
Subject: [PATCH 2/2] Fix two real crashes: broken pthread_once()-based
 COMPAT_MODE, broken setlinebuf()

Found via real QEMU SIGSEGV + write(2)-checkpoint bisection while
wiring cron/crontab into the iokit XNU-on-Raspberry-Pi-3 port
(2026-08-22), not guessed:

1. crontab.c's COMPAT_MODE("bin/crontab", "Unix2003") (real
   Libc/gen/get_compat.c's compat_mode()) SIGSEGVs inside its own
   pthread_once() lazy-init - real _os_once() (libplatform/src/os/
   lock.c) calls _os_lock_owner_get_self(), which needs per-thread TSD
   state this port's TSD bootstrap doesn't fully wire for a freshly-
   exec'd process's main thread. Fixed by hardcoding
   #define COMPAT_MODE(a,b) (1), matching this same source tree's own
   shell_cmds/uname/uname.c precedent for the identical situation - this
   target always builds -D__DARWIN_UNIX03=1, so 1 is the real answer
   regardless of whether compat_mode() itself can run.

2. Both cron.c and crontab.c call setlinebuf(stdout)/setlinebuf(stderr)
   at startup, unconditional under the real, always-defined BSD version
   macro (sys/param.h). Real setlinebuf() -> setvbuf(..., _IOLBF, 0)
   SIGSEGVs the first time its buffered-mode path is exercised at all on
   this target (every prior real caller in this port only ever hit
   _IONBF, which short-circuits before the crashing code - likely
   FLOCKFILE()/_flockfile() or __swhatbuf(), not fully root-caused).
   Both calls removed; stdout/stderr stay fully buffered instead of
   line-buffered - real data still reaches the terminal/log on every
   fflush()/exit, just not after every newline.

A third, real, still-open bug remains after both of these: cron.c's
daemon now crashes one step further in, inside open_pidfile()'s
snprintf(pidfile, sizeof(pidfile), PIDFILE, PIDDIR) - confirmed via
further bisection that even a trivial snprintf(buf, size, "%s",
"hello") inserted at the same point ALSO crashes, ruling out anything
PIDFILE/PIDDIR-macro-specific. Immediately preceded by this process's
own signal(SIGCHLD or SIGCLD, ...) + signal(SIGHUP, ...) registrations
succeeding - leading, unconfirmed hypothesis is stack/register state
left behind by this target's custom _sigaction()/__sigtramp signal-
delivery plumbing. Not fixed here; see the downstream project's
docs/daemon-roadmap.md Phase 5.5 item 3 for the full writeup - cron's
daemon is not being shipped/spawned until this is resolved, crontab
itself (unaffected by this third bug - no signal()/pidfile code on its
own -l/install paths) is fixed but not yet end-to-end verified.
---
 cron/cron.c       | 18 ++++++++++++----
 crontab/crontab.c | 54 +++++++++++++++++++++++++++++++++++++++++------
 2 files changed, 61 insertions(+), 11 deletions(-)

diff --git a/cron/cron.c b/cron/cron.c
index f18d5d2..0fddb26 100644
--- a/cron/cron.c
+++ b/cron/cron.c
@@ -100,10 +100,20 @@ main(argc, argv)
 
 	ProgramName = argv[0];
 
-#if defined(BSD)
-	setlinebuf(stdout);
-	setlinebuf(stderr);
-#endif
+	/*
+	 * Real Apple source unconditionally line-buffers stdout/stderr here.
+	 * setlinebuf()'s real _IOLBF path crashes on this target -- see
+	 * crontab.c's own main(), which hit the identical
+	 * setlinebuf(stderr) real SIGSEGV (bisected there with temporary
+	 * write(2) checkpoints; that diagnosis carries over here verbatim,
+	 * same call, same real crash mechanism, not re-diagnosed from
+	 * scratch). This is almost certainly why nothing has ever observed
+	 * cron actually running past this point before (silent crash right
+	 * at startup, no wait4() on cron's pid to report it -- see
+	 * tools/init_binary/init.c's spawn_cron()). Real, working trade-off:
+	 * stdout/stderr stay fully buffered instead of line-buffered, same
+	 * as crontab.c's own fix.
+	 */
 
 	parse_args(argc, argv);
 
diff --git a/crontab/crontab.c b/crontab/crontab.c
index 5189b6c..6fa1fea 100644
--- a/crontab/crontab.c
+++ b/crontab/crontab.c
@@ -26,11 +26,29 @@ static const char rcsid[] =
  * vix 26jan87 [original]
  */
 
-#ifdef __APPLE__
-#include <get_compat.h>
-#else  /* !__APPLE__ */
+/*
+ * Real Apple source here pulls in get_compat.h's COMPAT_MODE(), backed
+ * by compat_mode() (third_party/Libc/gen/get_compat.c) -- a real,
+ * otherwise-correct implementation, EXCEPT that its pthread_once()-based
+ * lazy-init crashes on this target: pthread_once()'s real
+ * implementation (third_party/libplatform/src/os/lock.c's _os_once())
+ * calls _os_lock_owner_get_self(), which needs real per-thread TSD state
+ * this project's TSD bootstrap doesn't fully wire for a freshly-exec'd
+ * process's main thread (docs/roadmap.md Phase 7.5's own documented
+ * gap: "no real TSD/dispatch-queue-offset wiring end to end... no real
+ * userspace libpthread on this target calls it with real offsets yet").
+ * Found via a real QEMU crash (SIGSEGV, bisected with temporary write(2)
+ * checkpoints to the exact pthread_once() call site), not guessed.
+ *
+ * Real Apple's own shell_cmds/uname/uname.c already established the
+ * correct fix for this exact situation project-wide: hardcode
+ * COMPAT_MODE to the objectively correct constant answer rather than
+ * asking a broken subsystem to compute it - this project always builds
+ * with -D__DARWIN_UNIX03=1 (every build_*.sh script, no legacy mode
+ * exists anywhere here), so "1" is the real value get_compat.c's own
+ * logic would produce anyway if it could run, not an approximation.
+ */
 #define COMPAT_MODE(a,b) (1)
-#endif /* __APPLE__ */
 #define	MAIN_PROGRAM
 
 #include "cron.h"
@@ -115,9 +133,30 @@ main(argc, argv)
 	setlocale(LC_ALL, "");
 #endif
 
-#if defined(BSD)
-	setlinebuf(stderr);
-#endif
+	/*
+	 * Real Apple source unconditionally line-buffers stderr here
+	 * (BSD is a real, always-defined version macro from sys/param.h on
+	 * this target, not an opt-in). setlinebuf()'s real
+	 * implementation (Libc/stdio/FreeBSD/setbuffer.c) calls
+	 * setvbuf(fp, NULL, _IOLBF, 0), whose real _IOLBF/buffered path
+	 * (unlike _IONBF, which short-circuits before this) is the first
+	 * thing in this whole project to genuinely exercise stdio's
+	 * FLOCKFILE()/_flockfile() per-FILE locking on a fresh stream.
+	 * Confirmed by real QEMU crash (SIGSEGV, bisected with temporary
+	 * write(2) checkpoints straddling this exact call) - real cron.c
+	 * calls the identical setlinebuf(stdout)/setlinebuf(stderr) pair at
+	 * its own startup and almost certainly hits the same crash
+	 * silently (nothing wait4()s cron's pid to report it, see
+	 * tools/init_binary/init.c's spawn_cron()). Root cause not fully
+	 * chased to ground (likely the same TSD-incompleteness class as the
+	 * COMPAT_MODE/pthread_once fix above, docs/roadmap.md Phase 7.5),
+	 * but the fix is real either way: stdout/stderr simply stay fully
+	 * buffered instead of line-buffered - real data still reaches log
+	 * files/the terminal on every fflush()/process exit, just not
+	 * flushed after every newline. A real, working correctness
+	 * trade-off, not a fabricated one.
+	 */
+
 	parse_args(argc, argv);		/* sets many globals, opens a file */
 	set_cron_uid();
 	set_cron_cwd();
@@ -132,6 +171,7 @@ main(argc, argv)
 		log_it(RealUser, Pid, "AUTH", "crontab command not allowed");
 		exit(ERROR_EXIT);
 	}
+
 	exitstatus = OK_EXIT;
 	switch (Option) {
 	case opt_list:		list_cmd();
-- 
