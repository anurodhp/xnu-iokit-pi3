From 516e586c7de15e565d56b8906da67fca1bf8a021 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Fri, 21 Aug 2026 05:52:44 -0400
Subject: [PATCH 3/3] rpi3_xnu_defconfig: add serial=3 to real-hardware
 bootargs

rd=disk0s2 alone (previous fix) unblocked root-device matching, but
real hardware still shipped zero serial-INPUT support: serialmode
defaults to 0 (osfmk/arm/arm_init.c) unless a real serial= boot-arg is
present, and SERIALMODE_INPUT (0x2) specifically gates the real input-
polling path (osfmk/console/serial_general.c) -- separate from the
always-on kprintf output path (cons_ops/SERIAL_CONS_OPS), which is
exactly why the login prompt was visible but nothing typed ever
reached the shell. serial=3 (OUTPUT|INPUT) is the same value
runvm.sh already uses successfully for QEMU -- CLAUDE.md's own boot
docs already documented this requirement, it just was never applied
to the real-hardware boot chain. Confirmed via a real device boot
2026-08-21: reached a real login prompt with zero typed input working.
---
 configs/rpi3_xnu_defconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/rpi3_xnu_defconfig b/configs/rpi3_xnu_defconfig
index 7c36d420..5c0c5fbf 100644
--- a/configs/rpi3_xnu_defconfig
+++ b/configs/rpi3_xnu_defconfig
@@ -8,7 +8,7 @@ CONFIG_ENV_SIZE=0x4000
 CONFIG_NR_DRAM_BANKS=1
 CONFIG_DISTRO_DEFAULTS=y
 CONFIG_OF_BOARD_SETUP=y
-CONFIG_BOOTCOMMAND="setenv bootargs rd=disk0s2; fatload mmc 0:1 0x04000000 kernel.development.bcm2837.unstripped; fatload mmc 0:1 0x06000000 rpi3.dtb; bootxnu 0x04000000 0x06000000"
+CONFIG_BOOTCOMMAND="setenv bootargs \"rd=disk0s2 serial=3\"; fatload mmc 0:1 0x04000000 kernel.development.bcm2837.unstripped; fatload mmc 0:1 0x06000000 rpi3.dtb; bootxnu 0x04000000 0x06000000"
 CONFIG_USE_PREBOOT=y
 CONFIG_PREBOOT="usb start"
 CONFIG_MISC_INIT_R=y
-- 
