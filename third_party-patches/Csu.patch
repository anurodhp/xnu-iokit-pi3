From a2709f253bf415048767b8e8389ec4b06e8b6498 Mon Sep 17 00:00:00 2001
From: Anurodh Pokharel <anurodhp@icloud.com>
Date: Sun, 16 Aug 2026 08:09:13 -0400
Subject: [PATCH 1/4] start.s: set real environ global at process entry (arm64)

Real crt.c's own _start() C function (which does `environ = envp;`) is
legacy, pre-10.5-only code, gated behind `#if __DYNAMIC__ &&
OLD_LIBSYSTEM_SUPPORT` -- genuinely dead in this build (neither macro
defined, confirmed via an empty preprocessed output). On real modern
Darwin, dyld itself populates `environ` before reaching this asm entry
point; this project has no dyld, so nothing else ever performed that
assignment. Latent since this project's first Csu work -- every prior
command only needed argc/argv (set up directly by this same asm,
independent of crt.c), so environ staying permanently NULL never
mattered until real envp/getenv plumbing was wired up
(iokit repo's Phase 4.6 "Real environment variable plumbing").

One store instruction, right before bl _main: x2 still holds envp at
that point (untouched by the preceding env-array NULL-scan loop), so
this does exactly what dyld's own ProgramVars registration would have
done for this one global.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UUxaiaAUwx3EcmMQrxztjG
---
 start.s | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/start.s b/start.s
index 2166de5..14f472b 100644
--- a/start.s
+++ b/start.s
@@ -253,6 +253,23 @@ start:
 L1: ldr     x4, [x3], #8
 	cmp     x4, #0              ; look for NULL ending env[] array
 	b.ne     L1
+	; Real Apple crt.c's own comment above documents that its _start()
+	; C function (which does `environ = envp;`) is legacy, pre-10.5-only
+	; code, gated behind `#if __DYNAMIC__ && OLD_LIBSYSTEM_SUPPORT` --
+	; genuinely dead in this build (neither macro defined) and NOT a
+	; bug: on real modern Darwin, dyld itself populates the `environ`
+	; global (via __program_vars/ProgramVars) before ever reaching this
+	; asm entry point. This project has no dyld (see architecture.md),
+	; so nothing else ever performs that real assignment -- confirmed
+	; via a real, empty preprocessed crt.c output for exactly this
+	; reason (docs/roadmap.md Phase 4.6 "Real environment variable
+	; plumbing"). One real store, matching exactly what dyld's own
+	; ProgramVars setup would have done for this one global (x2 still
+	; holds envp here, untouched by the scan loop above, which only
+	; mutates x3/x4).
+	adrp    x9, _environ@PAGE
+	add     x9, x9, _environ@PAGEOFF
+	str     x2, [x9]
 	bl      _main               ; main(x0=argc, x1=argv, x2=envp, x3=apple)
 	b       _exit
 
-- 
