Subject: [PATCH 2/3] CFXMLInterface.c: fix real bool/Boolean
 prototype-conflict vs CFXMLInterface.h

_CFXMLCopyNode/_CFXMLDocStandalone/_CFXMLDocSetStandalone/
_CFXMLDocValidate are defined 'bool' here but declared 'Boolean' in
CFXMLInterface.h -- a real, hard C prototype-conflict error under
strict recompilation (confirmed by a real trial build against
arm64-apple-ios14.4, iokit project, while porting libxml2). Same
category of bug as this patch's own CFPriv.h fix; Boolean matches
every other real signature in CFXMLInterface.h (5 Boolean vs this
file's 4 bool outliers), so the .c file's definitions are fixed to
match rather than the header.
---
 CoreFoundation/Parsing.subproj/CFXMLInterface.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/CoreFoundation/Parsing.subproj/CFXMLInterface.c b/CoreFoundation/Parsing.subproj/CFXMLInterface.c
index 0d56c42..424eb4a 100644
--- a/CoreFoundation/Parsing.subproj/CFXMLInterface.c
+++ b/CoreFoundation/Parsing.subproj/CFXMLInterface.c
@@ -357,7 +357,7 @@ _CFXMLNodePtr _CFXMLNewNode(_CFXMLNamespacePtr namespace, const char* name) {
     return xmlNewNode(namespace, (const xmlChar*)name);
 }
 
-_CFXMLNodePtr _CFXMLCopyNode(_CFXMLNodePtr node, bool recursive) {
+_CFXMLNodePtr _CFXMLCopyNode(_CFXMLNodePtr node, Boolean recursive) {
     int recurse = recursive ? 1 : 0;
     switch (((xmlNodePtr)node)->type) {
         case XML_DOCUMENT_NODE:
@@ -730,10 +730,10 @@ _CFXMLNodePtr _CFXMLNodeGetParent(_CFXMLNodePtr node) {
     return ((xmlNodePtr)node)->parent;
 }
 
-bool _CFXMLDocStandalone(_CFXMLDocPtr doc) {
+Boolean _CFXMLDocStandalone(_CFXMLDocPtr doc) {
     return ((xmlDocPtr)doc)->standalone == 1;
 }
-void _CFXMLDocSetStandalone(_CFXMLDocPtr doc, bool standalone) {
+void _CFXMLDocSetStandalone(_CFXMLDocPtr doc, Boolean standalone) {
     ((xmlDocPtr)doc)->standalone = standalone ? 1 : 0;
 }
 
@@ -1096,7 +1096,7 @@ void _CFXMLValidityErrorHandler(void* ctxt, const char* msg, ...) {
     free(formattedMessage);
 }
 
-bool _CFXMLDocValidate(_CFXMLDocPtr doc, CFErrorRef _Nullable * error) {
+Boolean _CFXMLDocValidate(_CFXMLDocPtr doc, CFErrorRef _Nullable * error) {
     CFMutableStringRef errorMessage = __CFSwiftXMLParserBridgeCF.CFStringCreateMutable(NULL, 0);
 
     xmlValidCtxtPtr ctxt = xmlNewValidCtxt();
