+	iokit_diag_syscall3(6 /* SYS_close */, fd, 0, 0);
+}
+
+__attribute__((constructor))
+static void
+iokit_diag_ctor(void)
+{
+	iokit_diag("DIAG: __mod_init_func constructor reached (before main())\n");
+}
