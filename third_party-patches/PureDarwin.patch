 1 file changed, 14 insertions(+), 26 deletions(-)

diff --git a/src/Libraries/XPC/launchd/launchd.c b/src/Libraries/XPC/launchd/launchd.c
index adb5c21..4aa92db 100644
--- a/src/Libraries/XPC/launchd/launchd.c
+++ b/src/Libraries/XPC/launchd/launchd.c
@@ -127,11 +127,7 @@ FILE *launchd_console = NULL;
 int32_t launchd_sync_frequency = 30;
 
 
-/* Real, locally-defined (this project's own static build, see
