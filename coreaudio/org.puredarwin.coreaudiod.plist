<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	coreaudio/ audio daemon (project-authored, like org.chrony.chronyd.plist).
	Started at boot and kept running (RunAtLoad, KeepAlive, audiod -k), so the
	first sound after boot, or after a pause, does not wait for launchd to start
	the daemon. It still claims its Mach service with the same MachServices
	check-in notifyd and configd use (tools/userland_staging/build_notifyd.sh
	header), and releases the audio engine while nothing plays. Without -k the
	daemon exits after 10 s without streams and launchd starts it on demand.
	StandardOutPath/ErrorPath for the same reason org.chrony.chronyd.plist
	documents: launchd does not wire an unconfigured job's stdio anywhere.

	ProcessType Interactive: THE fix for the audio stalls. This launchd build defaults a job with no
	ProcessType to POSIX_SPAWN_PROC_TYPE_DAEMON_BACKGROUND (core.c:2257, 4710): priority 4, throttled, and
	in xnu's background timer-coalescing class, where a 1.5 ms usleep took up to 50 ms. Measured on a Pi: the
	same audio_play that is clean from an ssh shell (sshd's plist sets ProcessType Standard) showed 49 resyncs
	and 60 ms gaps in 8 s when started by launchd. Interactive (core.c:2737-2745) is the class for latency-
	critical daemons (the loginwindow-style bootstrapper uses it, core.c:7284).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.puredarwin.coreaudiod</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/audiod</string>
		<string>-k</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>MachServices</key>
	<dict>
		<key>org.puredarwin.coreaudiod</key>
		<true/>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/log/audiod.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/audiod.log</string>
</dict>
</plist>
